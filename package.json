{
  "name": "slide-up",
  "private": true,
  "version": "0.0.0",
  "description": "Diffusion de diapositives PowerPoint via NDI",
  "author": "Slide-up",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:ndi": "node scripts/build-ndi.mjs",
    "ensure:ndi": "node scripts/ensure-ndi-bundle.mjs",
    "preview": "electron-vite preview",
    "dist": "npm run build:ndi && npm run ensure:ndi && npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.30",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.0.0"
  },
  "build": {
    "extends": "./electron-builder.yml"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron-winstaller@5.4.0": true
  }
}
